{
  "name": "openstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "dev": "turbo run dev --continue=always",
    "build": "turbo run build",
    "start": "turbo run start --continue=always",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@openstudio/database": "workspace:*",
    "turbo": "^2.0.0",
    "tsx": "^4.21.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
