# Optional in local dev: generated and persisted in .data/master.key on first start.
# Required for pnpm start. 32-byte hex key: openssl rand -hex 32
OPENSTUDIO_ENCRYPTION_KEY=
# Register/obtain an OAuth client with device flow and Copilot API access.
# Do not substitute another application's client ID without authorization.
GITHUB_COPILOT_CLIENT_ID=
# OpenAI ChatGPT OAuth uses official dynamic registration; no borrowed client ID needed.
# Ports are chosen once, saved in .data/runtime/*-port.json, and reused on restart.
# Optional explicit choices: frontend 3001-3999 (except 3659), backend 4001-4999 (except 4045).
# OPENSTUDIO_CLIENT_PORT=
# OPENSTUDIO_SERVER_PORT=
# Optional; each app resolves this relative to the repository root.
# OPENSTUDIO_DATA_DIR=.data
# Default: one local SQLite workspace shared across localhost/127.0.0.1/browsers.
OPENSTUDIO_WORKSPACE_MODE=local
# Use session for legacy cookie-isolated workspaces; this is not a hosted login system.
# Select another already migrated workspace explicitly (optional).
# OPENSTUDIO_LOCAL_WORKSPACE_ID=
